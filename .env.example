# Modo de laboratório (exibe painel de contas de teste na tela de login e recursos de estudo QA)
LAB_MODE=true

# Porta do servidor Express + Vite
PORT=3000

# Chave secreta JWT para sessões de laboratório (altere em ambiente compartilhado)
JWT_SECRET=nova-aurora-test-lab-secret-change-me

# Integração Supabase (Client + Server)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_supabase_anon_ou_publishable_key
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_supabase_anon_ou_publishable_key

# Opcional: Chave secreta (service_role / sb_secret_...) para operações administrativas no backend
# SUPABASE_SERVICE_ROLE_KEY=

# Opcional: String de conexão PostgreSQL do Supabase (Pooler SSL) para apontar o Drizzle/ORM ao Supabase
# SUPABASE_DB_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Banco PostgreSQL local/Docker/Cloud SQL (usado quando SUPABASE_DB_URL não está definido)
SQL_HOST=localhost
SQL_DB_NAME=nova_aurora
SQL_USER=aurora_app
SQL_PASSWORD=aurora_app_pass
SQL_ADMIN_USER=aurora_admin
SQL_ADMIN_PASSWORD=aurora_admin_pass

# Conta Super Admin exclusiva de laboratório (defina apenas nas variáveis de ambiente do servidor)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# GEMINI_API_KEY / APP_URL (injetados automaticamente pelo ambiente se configurados)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
