# Modo de laboratório (exibe painel de contas de teste na tela de login e recursos de estudo QA)
LAB_MODE=true

# Porta do servidor Express + Vite
PORT=3000

# Chave secreta JWT para sessões de laboratório (altere em ambiente compartilhado)
JWT_SECRET=nova-aurora-test-lab-secret-change-me

# Banco PostgreSQL (usado pelo pool Drizzle/pg e Docker Compose)
SQL_HOST=localhost
SQL_DB_NAME=nova_aurora
SQL_USER=aurora_app
SQL_PASSWORD=aurora_app_pass
SQL_ADMIN_USER=aurora_admin
SQL_ADMIN_PASSWORD=aurora_admin_pass

# GEMINI_API_KEY / APP_URL (injetados automaticamente pelo ambiente se configurados)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
